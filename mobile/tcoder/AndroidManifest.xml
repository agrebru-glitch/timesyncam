<?xml version="1.0" encoding="utf-8"?>
<!-- TCoder — экран синхронизации TimesynCam на телефоне. Версия задаётся при сборке (scripts/build-tcoder.mjs). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android" package="com.timesyncam.tcoder">
  <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34" />
  <application
    android:label="TCoder"
    android:icon="@mipmap/ic_launcher"
    android:allowBackup="false"
    android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
  </application>
</manifest>
